import kotlin.Boolean;

CREATE TABLE WorkOrderEntity (
    id TEXT NOT NULL PRIMARY KEY,
    buildingName TEXT NOT NULL,
    address TEXT NOT NULL,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    priority TEXT NOT NULL,
    scheduledAt TEXT,
    scheduledEnd TEXT,
    technicianId TEXT,
    technicianName TEXT,
    dispatcherNotes TEXT,
    technicianNotes TEXT,
    isSynced INTEGER AS Boolean DEFAULT 1
);

insertWorkOrder:
INSERT OR REPLACE INTO WorkOrderEntity(id, buildingName, address, type, status, priority, scheduledAt, scheduledEnd, technicianId, technicianName, dispatcherNotes, technicianNotes, isSynced)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllWorkOrders:
SELECT * FROM WorkOrderEntity;

selectWorkOrderById:
SELECT * FROM WorkOrderEntity WHERE id = ?;

updateWorkOrderStatus:
UPDATE WorkOrderEntity SET status = ?, isSynced = 0 WHERE id = ?;

deleteWorkOrder:
DELETE FROM WorkOrderEntity WHERE id = ?;

clearWorkOrders:
DELETE FROM WorkOrderEntity;

-- Inspection and Checklist Tables
CREATE TABLE InspectionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    workOrderId TEXT NOT NULL,
    technicianId TEXT NOT NULL,
    status TEXT NOT NULL, -- IN_PROGRESS, COMPLETED
    startedAt TEXT,
    completedAt TEXT,
    notes TEXT,
    isSynced INTEGER AS Boolean DEFAULT 0
);

CREATE TABLE ChecklistItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    inspectionId TEXT NOT NULL,
    questionKey TEXT NOT NULL,
    response TEXT, -- YES, NO, N/A or text
    observations TEXT,
    isSynced INTEGER AS Boolean DEFAULT 0
);

insertInspection:
INSERT OR REPLACE INTO InspectionEntity(id, workOrderId, technicianId, status, startedAt, completedAt, notes, isSynced)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertChecklistItem:
INSERT OR REPLACE INTO ChecklistItemEntity(id, inspectionId, questionKey, response, observations, isSynced)
VALUES (?, ?, ?, ?, ?, ?);

selectInspectionByWorkOrder:
SELECT * FROM InspectionEntity WHERE workOrderId = ?;

selectChecklistItems:
SELECT * FROM ChecklistItemEntity WHERE inspectionId = ?;

-- Session Table for Auto Login
CREATE TABLE SessionEntity (
    id INTEGER PRIMARY KEY CHECK (id = 1), -- Only one active session
    userId TEXT NOT NULL,
    email TEXT NOT NULL,
    firstName TEXT,
    lastName TEXT,
    role TEXT NOT NULL,
    token TEXT NOT NULL DEFAULT ""
);

saveSession:
INSERT OR REPLACE INTO SessionEntity(id, userId, email, firstName, lastName, role, token)
VALUES (1, ?, ?, ?, ?, ?, ?);

getSession:
SELECT * FROM SessionEntity WHERE id = 1;

clearSession:
DELETE FROM SessionEntity WHERE id = 1;

-- Timesheet Table
CREATE TABLE TimeEntryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    clockInTime INTEGER NOT NULL,
    clockOutTime INTEGER,
    type TEXT NOT NULL,
    workOrderId TEXT,
    workOrderTitle TEXT,
    notes TEXT,
    date TEXT NOT NULL
);

insertTimeEntry:
INSERT OR REPLACE INTO TimeEntryEntity(id, userId, clockInTime, clockOutTime, type, workOrderId, workOrderTitle, notes, date)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateClockOut:
UPDATE TimeEntryEntity SET clockOutTime = ? WHERE id = ?;

updateClockOutWithNotes:
UPDATE TimeEntryEntity SET clockOutTime = :clockOutTime, notes = COALESCE(:notes, notes) WHERE id = :id;

getActiveTimeEntry:
SELECT * FROM TimeEntryEntity WHERE userId = ? AND clockOutTime IS NULL ORDER BY clockInTime DESC LIMIT 1;

getTimeEntriesForUser:
SELECT * FROM TimeEntryEntity WHERE userId = ? ORDER BY clockInTime DESC;

getTimeEntriesForUserAndDate:
SELECT * FROM TimeEntryEntity WHERE userId = ? AND date = ? ORDER BY clockInTime DESC;

clearTimeEntriesForUser:
DELETE FROM TimeEntryEntity WHERE userId = ?;

getAllActiveTimeEntries:
SELECT * FROM TimeEntryEntity WHERE clockOutTime IS NULL;


